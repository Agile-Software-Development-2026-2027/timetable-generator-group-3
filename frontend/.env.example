# Copy to .env.local and fill in the values. Never commit .env.local.

# Backend API (defaults to http://localhost:8000 when unset).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Auth. The real values are shared privately by the project maintainer (Brian).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Copy this file to .env and set DATABASE_URL for your local environment.
# The backend reads DATABASE_URL at startup; credentials are never hardcoded.
# NEVER commit your real .env — it is git-ignored on purpose.

# Shared Supabase database (connection pooler, transaction mode, port 6543).
# Ask the project maintainer for the full connection string (sent privately).
# Placeholders below — do not fill them in this example file:
#   DATABASE_URL=postgresql+psycopg2://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# For a quick local run without Supabase you can use SQLite:
DATABASE_URL=sqlite:///./timetable.db

# Supabase Auth (KAN-44). Ask the project maintainer for the real values.
# SUPABASE_URL is the project URL; when set, tokens must come from it.
SUPABASE_URL=
# Set ONE of the two, depending on how the Supabase project signs its tokens
# (Project Settings -> JWT Keys):
#   - legacy shared secret (HS256):
SUPABASE_JWT_SECRET=
#   - asymmetric signing keys, e.g. https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=

# User management (KAN-69). The service role key can create and ban accounts:
# keep it here only, never in the frontend. Ask the project maintainer for it.
SUPABASE_SERVICE_ROLE_KEY=
# Page the invite email links to, where new users choose their password.
# It must be listed in Supabase -> Authentication -> URL Configuration -> Redirect URLs.
INVITE_REDIRECT_URL=http://localhost:3000/set-password

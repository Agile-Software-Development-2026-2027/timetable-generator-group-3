# Copy this file to .env and set DATABASE_URL for your local environment.
# The backend reads DATABASE_URL at startup; credentials are never hardcoded.
# NEVER commit your real .env — it is git-ignored on purpose.

# Shared Supabase database (connection pooler, session mode).
# Ask the project maintainer for the full connection string (sent privately).
# Placeholders below — do not fill them in this example file:
#   DATABASE_URL=postgresql+psycopg2://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# For a quick local run without Supabase you can use SQLite:
DATABASE_URL=sqlite:///./timetable.db
